# Copy to .env.local for local testing, and add the same values in Vercel > Settings > Environment Variables.
GROQ_API_KEY=
# Optional text & screening model (defaults to openai/gpt-oss-120b)
GROQ_MODEL=openai/gpt-oss-120b
# Optional vision model for the photo-CV fallback
GROQ_VISION_MODEL=

# Shared storage (needed for accounts and for applications to reach recruiters on other devices).
# In Vercel: Storage > Create > Upstash Redis, connect it to the project. It sets these two for you.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Public address of the site, used in email links. Example: https://scout-screener.vercel.app
SITE_URL=

# Sign in with Google. Google Cloud Console > APIs & Services > Credentials > Create OAuth client ID > Web application.
# Add your site address under "Authorized JavaScript origins". Paste the Client ID here (it is not secret).
GOOGLE_CLIENT_ID=

# Email (password reset, "shortlisted" and "new applicant" emails). Use ONE of these.
# Brevo (recommended, free 300 a day, you can send from a verified Gmail address):
BREVO_API_KEY=
# Or Resend (can only email other people after you verify a domain):
RESEND_API_KEY=
# Sender. Must be the address you verified with the provider.
MAIL_FROM=Scout <you@example.com>
