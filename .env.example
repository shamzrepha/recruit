# Copy to .env.local for local testing, and add the same values in Vercel > Settings > Environment Variables.
GROQ_API_KEY=
# Optional text & screening model (defaults to llama-3.3-70b-versatile)
GROQ_MODEL=llama-3.3-70b-versatile
# Optional multimodal vision model for server OCR fallback (defaults to qwen/qwen3.8-27b)
GROQ_VISION_MODEL=qwen/qwen3.8-27b

# Optional Firebase / Firestore configuration for multi-device sync
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
